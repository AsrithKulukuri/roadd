# ====================================================================
# ROAD Project - Environment Variables Configuration
# ====================================================================

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Client-side accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# HMAC signing key for ROAD's HttpOnly application session (32+ random characters)
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
# Optional separate HMAC key for anonymizing OTP request IP addresses.
# Falls back to SESSION_SECRET when omitted.
RATE_LIMIT_HASH_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
# Optional separate HMAC key for OTP hashes. Falls back to SESSION_SECRET.
OTP_HASH_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Trial accounts require 60000. Paid accounts with Account Protection may use 5000 or higher.

# ====================================================================
# ====================================================================
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API Credentials (Server-only - Never expose to client!)
# Meta Developer Portal: https://developers.facebook.com/apps
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=your-meta-permanent-system-user-access-token
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
META_WHATSAPP_API_VERSION=v21.0

# Meta Webhook Verification (Set the same verify token in Meta App Dashboard > WhatsApp > Configuration)
META_WEBHOOK_VERIFY_TOKEN=your-meta-verify-token
# Required: Meta App Secret for validating incoming X-Hub-Signature-256 HMAC payload signatures
META_APP_SECRET=your-meta-app-secret

# Meta Pre-Approved Message Template Names (Configure in Meta Business Manager)
META_OTP_TEMPLATE_NAME=road_auth_otp
META_TEMPLATE_LANGUAGE=en_US
# META_VISIT_CONFIRMED_TEMPLATE_NAME=road_visit_confirmed
# META_VISIT_REMINDER_TEMPLATE_NAME=road_visit_reminder
# META_BROADCAST_TEMPLATE_NAME=road_property_broadcast


# Map Tile Provider (Optional - Defaults to free OpenStreetMap and Esri tiles without key)
# NEXT_PUBLIC_CARTO_API_KEY=your-cartodb-api-key
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Site visit confirmations use the approved one-body-parameter Meta template.
META_SITE_VISIT_TEMPLATE_NAME=road_alert_notification
META_NOTIFICATION_MODE=live
META_OTP_MODE=live
META_BROADCAST_INTERVAL_MS=250
